THIRDSHIFT_COORDINATOR_ADDR=:8080
THIRDSHIFT_VERSION=0.1.0-alpha.0
THIRDSHIFT_POSTGRES_PORT=5432
THIRDSHIFT_DATABASE_URL=postgres://thirdshift:replace-me-local-only@localhost:5432/thirdshift?sslmode=disable
THIRDSHIFT_OPERATOR_TOKEN=replace-me-local-operator-token
THIRDSHIFT_ACCESS_TOKEN_SECRET=replace-me-with-random-local-secret
THIRDSHIFT_HEARTBEAT_INTERVAL_SECONDS=15
THIRDSHIFT_SESSION_STALE_AFTER_SECONDS=45
THIRDSHIFT_STALE_SWEEP_INTERVAL_SECONDS=15
THIRDSHIFT_CREDIT_HOLD_SECONDS=86400
THIRDSHIFT_SCHEDULER_WEIGHT_WARM_MODEL=40
THIRDSHIFT_SCHEDULER_WEIGHT_SUCCESS_RATE=20
THIRDSHIFT_SCHEDULER_WEIGHT_TOKENS_PER_SECOND=15
THIRDSHIFT_SCHEDULER_WEIGHT_RECENT_FAILURE=10
THIRDSHIFT_SCHEDULER_WEIGHT_THERMAL=5
THIRDSHIFT_SCHEDULER_WEIGHT_FAIRNESS=5
THIRDSHIFT_SCHEDULER_WEIGHT_REGION=5
