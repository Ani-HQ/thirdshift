{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thirdshift job.accepted message",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "job.accepted"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["job_id", "attempt_id", "accepted_at"],
          "properties": {
            "job_id": {"type": "string"},
            "attempt_id": {"type": "string"},
            "accepted_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  ]
}

