{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thirdshift model.unload message",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "model.unload"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "reason", "deadline_at"],
          "properties": {
            "model_id": {"type": "string"},
            "reason": {"type": "string"},
            "deadline_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  ]
}

