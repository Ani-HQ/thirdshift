{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thirdshift node.safety_event message",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "node.safety_event"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "event_code", "severity", "message", "occurred_at"],
          "properties": {
            "node_id": {"type": "string"},
            "event_code": {"type": "string"},
            "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
            "message": {"type": "string"},
            "temperature_c": {"type": "integer"},
            "power_w": {"type": "integer", "minimum": 0},
            "occurred_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  ]
}

