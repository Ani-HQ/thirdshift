{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thirdshift job.offer lease payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "attempt_id",
    "lease_expires_at",
    "deadline_at",
    "model_id",
    "request",
    "verification"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,120}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "max_tokens", "stream"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant"]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "seed": {
          "type": "integer"
        },
        "stream": {
          "const": false
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "challenge_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["standard", "challenge", "duplicate"]
        },
        "challenge_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}

